# EcoScrap Backend - Environment Configuration Example
# Copy this file to .env and set your deployment credentials.
# NEVER commit real credentials or production secrets to Git.

# MongoDB Connection (MongoDB Atlas connection string for production)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# Database Name (default: ewaste)
DATABASE_NAME=ewaste

# JWT Secret Key - Use a cryptographically secure random string in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# JWT Token Configuration (defaults: HS256 algorithm, 60 minutes expiry)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# Example for production: https://ecoscrap.vercel.app
FRONTEND_URL=http://localhost:5173

# Environment name (development / production)
ENVIRONMENT=development
